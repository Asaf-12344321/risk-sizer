RISK_SIZER_ENV=production
RISK_SIZER_DB_PATH=/var/lib/risk-sizer/risk_sizer.db
RISK_SIZER_API_KEY=replace-with-a-long-random-secret
# Same-origin serving needs no CORS entry. Add only a separate PWA origin if used.
RISK_SIZER_CORS_ORIGINS=https://risk.example.com
# Generate a VAPID key pair once and store it only in this root-readable file. The public
# key is safe for the browser; the private key is used only by the server to deliver stop
# notifications. The subject may be a mailto: address or this HTTPS site URL.
RISK_SIZER_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
RISK_SIZER_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
RISK_SIZER_VAPID_SUBJECT=https://risk.example.com
